# ==============================================
# Auto Money Printer — Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# Инструкция по получению ключей: см. README.md

# --- Telegram (ОБЯЗАТЕЛЬНО) ---
# Получить: @BotFather в Telegram → /newbot
TG_BOT_TOKEN=your_bot_token_here
# ID канала: переслать сообщение из канала в @getmyid_bot
TG_CHANNEL_ID=@your_channel_username
# ID админов через запятую (получить в @getmyid_bot)
TG_ADMIN_IDS=123456789
# Интервал постинга в канал (часы)
TG_POSTING_INTERVAL_HOURS=3
# Час отправки рекламного сообщения (UTC, 0-23)
TG_AD_MESSAGE_HOUR=10

# --- ePN.bz (рекомендуется) ---
# Получить: epn.bz → регистрация вебмастера → Настройки → API
EPN_API_KEY=your_epn_api_key
EPN_USER_ID=your_epn_user_id

# --- Admitad (опционально) ---
# Получить: admitad.com → Вебмастер → Инструменты → API
ADMITAD_CLIENT_ID=your_admitad_client_id
ADMITAD_CLIENT_SECRET=your_admitad_client_secret

# --- Leadgid (опционально) ---
# Получить: leadgid.ru → кабинет → API
LEADGID_API_TOKEN=your_leadgid_token

# --- NewsAPI (опционально, для новостей) ---
# Получить: newsapi.org → Get API Key (бесплатно)
NEWS_API_KEY=your_news_api_key
# Темы новостей через запятую
NEWS_TOPICS=технологии,скидки,финансы

# --- RSS-ленты (опционально, работает без ключей) ---
RSS_FEEDS=https://lenta.ru/rss,https://ria.ru/export/rss2/archive/index.xml

# --- Gemini AI (опционально, для генерации контента) ---
# Получить: aistudio.google.com → Get API Key (бесплатно)
GEMINI_API_KEY=your_gemini_api_key

# --- Настройки ---
CHECK_NEW_OFFERS_INTERVAL_HOURS=6
ANALYTICS_REPORT_HOUR=20
MAX_SUBSCRIBERS_FOR_ADS=0
