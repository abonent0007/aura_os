# freelance-hunter — конфигурация
# Глобальные ключи Ауры подставляются из C:\aura_os\.env через ${VAR}.
# Локальный .env проекта (если есть) имеет приоритет.

sources:
  - name: fl.ru
    url: https://www.fl.ru/rss/all.xml
  # kwork RSS — витрина исполнителей («Найду/Свяжу/Сделаю» за 500 ₽), а не заказы.
  # Заказы kwork публичной лентой не отдаёт — источник отключён.
  # - name: kwork
  #   url: https://kwork.ru/rss

accept_keywords: [скрипт, парсер, бот, автоматизация, донастроить, исправить, excel, google sheets]
reject_keywords: [интеграция, crm, мобильное приложение, срочно, дизайн, 1с]

min_score: 1
min_length: 30
max_length: 1200

db_path: orders.db

# Оценка заказов — через тот же DeepSeek, что и сама Аура
llm_base_url: https://api.deepseek.com/v1
llm_api_key: ${DEEPSEEK_API_KEY}
llm_model: deepseek-flash
llm_timeout: 30

# Telegram без VPN недоступен — оставлено выключенным.
# Если появится VPN: заполни оба поля, и уведомления включатся.
telegram_token: ""
telegram_chat_id: ""

fallback_price: 3000
fallback_days: 3

telegram_timeout: 10
fetch_timeout: 20
