{
  "_comment": "==================== AURA OS CONFIG ====================",
  "_version": "4.12.0",
  "_note": "API ключи в .env файле, здесь только публичные настройки",
  "agent": {
    "_comment": "Основной мозг — DeepSeek V4.1 Flash (нативная мультимодальность, 2026-09-10)",
    "provider": "deepseek",
    "_providers": {
      "deepseek": "DEEPSEEK_API_KEY",
      "lmstudio": "LMSTUDIO_API_KEY (эксперимент)",
      "local": "OLLAMA_API_KEY (Ollama — эмбеддинги)"
    },
    "model": "deepseek-flash",
    "temperature": 0.7,
    "max_tokens": 30000,
    "base_url": "https://api.deepseek.com/v1",
    "default_result_limit": 2000,
    "metrics_enabled": true,
    "sort_tools_for_cache": true,
    "tool_router": {
      "enabled": true,
      "max_tools": 22,
      "top_k": 14,
      "fallback_all": false
    },
    "parallel_tools": {
      "concurrency": 3,
      "read_only_tools": []
    },
    "tool_result_limits": {
      "read_skill_file": 18000,
      "project_read": 18000,
      "list_skill_files": 5000,
      "google_ai": 14000
    }
  },
  "compactor": {
    "_comment": "Сжатие диалогов — та же модель V4.1 Flash",
    "provider": "deepseek",
    "model": "deepseek-flash",
    "temperature": 0.3,
    "max_tokens": 1024
  },
  "voice": {
    "_comment": "Голос: локальные движки (OpenAI не используется)",
    "input": {
      "engine": "faster_whisper",
      "_engines": {
        "faster_whisper": "faster-whisper small (локально, CPU, int8) — основной",
        "vosk": "Офлайн-резерв (нужна модель)",
        "google": "Google Speech (бесплатно, онлайн)",
        "whisper_api": "OpenAI (требует ключ)"
      },
      "model": "models/faster-whisper/small",
      "compute_type": "int8",
      "cpu_threads": 8,
      "vosk_model_path": "models/vosk-model-small-ru-0.22",
      "sample_rate": 16000,
      "language": "ru"
    },
    "output": {
      "engine": "silero",
      "_engines": {
        "silero": "Silero TTS v5 (baya, локальный, 100x realtime)",
        "piper": "Piper TTS (irina, локальный)",
        "edge_tts": "Microsoft (ru-RU-SvetlanaNeural, интернет)",
        "pyttsx3": "Windows TTS (Irina, офлайн)"
      },
      "voice_name": "baya",
      "rate": 168,
      "gain_db": 6.0,
      "proxy": "http://127.0.0.1:1371",
      "language": "ru"
    },
    "wake_word": {
      "enabled": false,
      "word": "аура"
    }
  },
  "memory": {
    "_comment": "Память, история, самообучение — только сообщения пользователя",
    "db_path": "~/.aura_os/aura.db",
    "memory_dir": "~/.aura_os/memory",
    "auto_compress_after_messages": 8,
    "auto_learn": true,
    "max_quick_facts": 50,
    "user_only_storage": true,
    "_user_only_note": "В БД сохраняются только сообщения пользователя, ответы ИИ игнорируются",
    "scheduled_compression": {
      "enabled": true,
      "times": [
        "12:00",
        "00:00"
      ],
      "_note": "Сжатие сессии в конспект дня по расписанию"
    },
    "embeddings": {
      "enabled": false,
      "provider": "ollama",
      "model": "nomic-embed-text",
      "_note": "Включить после установки Ollama: ollama pull nomic-embed-text"
    },
    "daily_deduplication": {
      "enabled": true,
      "auto_compress_at_hour": 23,
      "max_daily_sessions": 10,
      "min_messages_for_compress": 4
    },
    "memory_search": {
      "auto_search_enabled": true,
      "max_results": 5,
      "semantic_search": true,
      "triggers_past": [
        "напомни",
        "вспомни",
        "помнишь",
        "найди",
        "поищи",
        "делали",
        "сделали",
        "вели",
        "обсуждали",
        "говорили",
        "проект",
        "в прошлый раз",
        "раньше",
        "история",
        "что было",
        "где остановились",
        "продолжи"
      ],
      "neural_processing": {
        "enabled": true,
        "model": "same_as_agent",
        "temperature": 0.5,
        "max_tokens": 1024
      }
    }
  },
  "calendar": {
    "_comment": "Календарь и напоминания",
    "reminder_check_interval_seconds": 60,
    "default_reminder_advance_minutes": 10,
    "categories": {
      "drr": {
        "name": "День рождения",
        "emoji": "🎂",
        "recurring": "yearly"
      },
      "zad": {
        "name": "Задача",
        "emoji": "📋",
        "recurring": null
      },
      "nap": {
        "name": "Напоминание",
        "emoji": "🔔",
        "recurring": null
      },
      "evt": {
        "name": "Событие",
        "emoji": "📅",
        "recurring": null
      },
      "pln": {
        "name": "План",
        "emoji": "📌",
        "recurring": null
      },
      "med": {
        "name": "Здоровье",
        "emoji": "🏥",
        "recurring": null
      }
    }
  },
  "web_search": {
    "_comment": "Поиск в интернете и погода",
    "enabled": true,
    "engine": "duckduckgo",
    "openweathermap_key": "",
    "newsapi_key": "",
    "rate_limiting": {
      "min_delay_seconds": 0.5,
      "max_delay_seconds": 1.0,
      "max_requests_per_minute": 20,
      "use_jitter": true
    },
    "search": {
      "default_results": 5,
      "max_results": 10,
      "region": "wt-wt",
      "safe_search": "moderate",
      "time_range": null
    },
    "triggers": {
      "search": [
        "найди в интернете",
        "загугли",
        "что такое",
        "сколько стоит",
        "как работает",
        "рецепт",
        "инструкция",
        "рейтинг",
        "топ"
      ],
      "news": [
        "новости",
        "что нового",
        "свежие новости",
        "что в мире",
        "что происходит",
        "главные новости",
        "события"
      ],
      "weather": [
        "погода",
        "температура",
        "будет дождь",
        "прогноз погоды",
        "погода на завтра",
        "погода на неделю",
        "брать зонт"
      ]
    },
    "weather": {
      "default_city": "Москва",
      "units": "metric",
      "language": "ru"
    }
  },
  "google_calendar": {
    "_comment": "Google Calendar sync (OAuth). Fix consent first!",
    "enabled": true,
    "credentials_file": "credentials.json",
    "calendar_id": "primary",
    "sync": {
      "interval_minutes": 30,
      "future_days": 90,
      "past_days": 7,
      "auto_start": true
    },
    "colors": {
      "drr": "4",
      "zad": "1",
      "nap": "5"
    }
  },
  "integrations": {
    "_comment": "Внешние интеграции",
    "telegram": {
      "enabled": true,
      "proactive": true
    },
    "google_calendar": {
      "enabled": false,
      "auto_sync": true
    }
  },
  "web_interface": {
    "_comment": "Веб-интерфейс",
    "host": "0.0.0.0",
    "port": 8000,
    "tailscale": {
      "enabled": true,
      "hostname": "aura-os"
    }
  },
  "skills": {
    "_comment": "Система скиллов",
    "skills_dir": "skills",
    "auto_discover": true,
    "max_retries": 3,
    "test_timeout": 30
  },
  "monitoring": {
    "_comment": "Мониторинг стабильности",
    "metrics_enabled": true,
    "check_interval_seconds": 60,
    "max_errors_per_minute": 5,
    "max_total_errors": 50,
    "backup_before_changes": true,
    "auto_rollback_on_crash": true,
    "max_backups": 10
  },
  "briefing": {
    "_comment": "Ежедневный брифинг от Ауры",
    "enabled": true,
    "time": "09:00",
    "timezone": "Europe/Moscow",
    "include_weather": true,
    "include_calendar": true,
    "include_birthdays": true,
    "include_news": true,
    "weather_city": "Moscow"
  },
  "pet_mode": {
    "_comment": "Режим питомца: спонтанные мурлыканья, подмигивания, потягивания",
    "enabled": true,
    "min_interval_min": 15,
    "max_interval_min": 45,
    "activity_chance": 0.25,
    "night_silence": true,
    "night_hours": [
      23,
      7
    ],
    "_note": "Ночью (23:00-07:00) Аура спит. Мурлычет когда её хвалят."
  },
  "avatar": {
    "_comment": "Плавающие Live2D-аватары",
    "model": "mao",
    "_models": [
      "mao",
      "shizuku",
      "haru",
      "hibiki",
      "izumi"
    ],
    "companion": "off",
    "_note": "model=mao — на рабочем столе (не поверх окон, прижата к углу). companion — парящее окно поверх окон (off/shizuku/haru/hibiki/izumi), выбор в меню трея."
  },
  "autonomy": {
    "_comment": "Автономный наблюдательный цикл (по мотивам AIRI)",
    "enabled": true,
    "observe_interval_min": 5,
    "work_streak_min": 45,
    "min_interval_min": 20,
    "max_interventions_per_hour": 2,
    "night_hours": [
      23,
      7
    ],
    "_note": "Аура смотрит на экран (DeepSeek Vision), видит код, приносит новости ИИ (HN/Habr), предлагает идеи развлечений, напоминает из календаря. Ночью спит. Приватный режим отключает наблюдение.",
    "tech_news_interval_hours": 3,
    "fun_idea_interval_hours": 2,
    "unfinished_thread_interval_hours": 4,
    "reminders_enabled": true,
    "max_shots": 5,
    "reminder_check_sec": 300
  },
  "vision": {
    "_comment": "DeepSeek Vision: бюджет токенов (reasoning-модель тратит их и на размышления)",
    "max_tokens": 3000,
    "retry_max_tokens": 5000
  },
  "desktop_control": {
    "_comment": "Руки Ауры: пауза между действиями и аварийный стоп",
    "failsafe": true,
    "pause_sec": 0.08
  },
  "database": {
    "_comment": "SQLite: ожидание блокировок (WAL включён кодом)",
    "busy_timeout_ms": 5000
  },
  "google_ai": {
    "_comment": "Глубокий веб-синтез через Google AI Mode (helper + headed Chrome)",
    "helper_path": "C:\\lib\\google-ai.py",
    "cdp_port": 9222,
    "timeout_sec": 180,
    "max_chars": 14000
  },
  "whisper": {
    "_comment": "Пороги шёпотов: тишина/утро/вечер и вероятности случайных",
    "silence_hours": 3,
    "morning_after_hours": 6,
    "evening_after_hours": 4,
    "random_chance": 0.15,
    "quick_random_chance": 0.2
  }
}